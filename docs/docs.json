{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Validity",
  "description": "Validation for Kotlin, written in plain Kotlin.",
  "colors": {
    "primary": "#7F52FF",
    "light": "#A98BFF",
    "dark": "#7F52FF"
  },
  "logo": {
    "light": "/logo/wordmark-light.svg",
    "dark": "/logo/wordmark-dark.svg",
    "href": "/"
  },
  "favicon": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 650
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0C0A14"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "appearance": {
    "default": "light"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "0.1.0",
        "icon": "tag",
        "href": "https://github.com/soleworks/validity/releases/latest"
      },
      {
        "type": "github",
        "href": "https://github.com/soleworks/validity"
      },
      {
        "label": "Sponsor",
        "icon": "heart",
        "href": "https://github.com/sponsors/marioalvial"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/soleworks/validity"
    },
    "links": [
      {
        "header": "Support",
        "items": [
          {
            "label": "Sponsor Validity",
            "href": "https://github.com/sponsors/marioalvial"
          }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "quickstart",
              "modules"
            ]
          },
          {
            "group": "Declaring a validation",
            "pages": [
              "guides/in-the-class",
              "guides/beside-the-class",
              "guides/context"
            ]
          },
          {
            "group": "Inside a validation",
            "pages": [
              "guides/null-values",
              "guides/nested-objects",
              "guides/collections-and-maps",
              "guides/across-fields",
              "guides/converting-values"
            ]
          },
          {
            "group": "Your own constraints",
            "pages": [
              "guides/custom-constraints",
              "guides/combining-constraints",
              "guides/fail-fast"
            ]
          },
          {
            "group": "Running a validation",
            "pages": [
              "guides/coroutines",
              "guides/results",
              "guides/exceptions",
              "guides/metadata"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "guides/configuration",
              "guides/messages",
              "guides/time"
            ]
          },
          {
            "group": "For AI agents",
            "pages": [
              "ai-agents"
            ]
          }
        ]
      },
      {
        "tab": "Constraints",
        "icon": "list-checks",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "constraints/overview"
            ]
          },
          {
            "group": "By type",
            "pages": [
              "constraints/any",
              "constraints/booleans",
              "constraints/strings",
              "constraints/numbers",
              "constraints/collections",
              "constraints/maps",
              "constraints/dates-and-times",
              "constraints/calendar",
              "constraints/durations"
            ]
          },
          {
            "group": "By format of a String",
            "pages": [
              "constraints/internet",
              "constraints/identifiers",
              "constraints/encodings",
              "constraints/finance",
              "constraints/location",
              "constraints/colors",
              "constraints/date-formats",
              "constraints/countries",
              "constraints/phone"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/installation",
      "destination": "/modules"
    },
    {
      "source": "/reference/modules",
      "destination": "/modules"
    },
    {
      "source": "/reference/messages",
      "destination": "/guides/messages"
    },
    {
      "source": "/guides/rules-in-the-class",
      "destination": "/guides/in-the-class"
    },
    {
      "source": "/guides/rules-beside-the-class",
      "destination": "/guides/beside-the-class"
    },
    {
      "source": "/guides/rules-across-fields",
      "destination": "/guides/across-fields"
    }
  ],
  "variables": {
    "version": "0.1.0",
    "kotlin": "2.4",
    "java": "17",
    "site": "https://validity-kt.dev",
    "constraints": "221",
    "postalCountries": "72",
    "documentCountries": "36"
  }
}
