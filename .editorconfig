root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official

# Every parameter goes on its own line, in a function and in a class.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1

# Imports are sorted alphabetically, with no groups, and never with a wildcard.
ij_kotlin_imports_layout = *
ij_kotlin_packages_to_use_import_on_demand = unset

# No trailing commas.
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

# An expression body starts on the signature line: `): Unit = constraint(`.
ktlint_function_signature_body_expression_wrapping = default
ktlint_standard_multiline-expression-wrapping = disabled
# A branch or a loop with one statement has no braces (Detekt's BracesOnIfStatements decides).
ktlint_standard_multiline-if-else = disabled
ktlint_standard_multiline-loop = disabled

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.bat]
end_of_line = crlf
